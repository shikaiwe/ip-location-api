[Unit]
Description=IP Location API Service
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/ip-location-api
Environment="PATH=/opt/ip-location-api/venv/bin"
Environment="PYTHONPATH=/opt/ip-location-api/src"
ExecStart=/opt/ip-location-api/venv/bin/uvicorn ip_location_api.main:app --host 0.0.0.0 --port 8000 --workers 4
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
